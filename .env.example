# CompatIQ Environment Variables
# Copy to .env.local and fill in your credentials.
# Do NOT commit .env.local to source control.

# ─── eBay Browse API ────────────────────────────────────────────────────────
# https://developer.ebay.com/
# Required for: parts search, device store search
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_ZA

# ─── SerpApi ────────────────────────────────────────────────────────────────
# https://serpapi.com/
# Required for: parts search, store search, review signals
# Uses: Google Shopping and Google Search engines
SERPAPI_API_KEY=

# ─── Best Buy Products API ──────────────────────────────────────────────────
# https://bestbuyapis.github.io/api-documentation/
# Required for: store search (US market mainly)
BESTBUY_API_KEY=

# ─── UPC / Barcode Lookup APIs ──────────────────────────────────────────────
# Used when UPC / EAN / GTIN / barcode is detected on a product page
UPCITEMDB_API_KEY=
BARCODELOOKUP_API_KEY=
EAN_SEARCH_API_KEY=
GOUPC_API_KEY=

# ─── Amazon Product Advertising API ────────────────────────────────────────
# https://webservices.amazon.com/paapi5/documentation/
# Requires Amazon Associates account with qualifying sales activity
# Public Amazon page metadata may still be extracted via GenericMetadataProvider
# without this key when user pastes an Amazon URL
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_PARTNER_TAG=

# ─── Manufacturer Serial Lookup APIs ────────────────────────────────────────
# Serial numbers are never logged, never sent via GET, never stored in URLs

DELL_CLIENT_ID=
DELL_CLIENT_SECRET=

HP_API_KEY=

LENOVO_API_KEY=

# Apple GSX — requires Apple Authorised Service Provider agreement
APPLE_GSX_CERT=
APPLE_GSX_KEY=

SAMSUNG_API_KEY=
ASUS_API_KEY=
ACER_API_KEY=
MICROSOFT_SURFACE_API_KEY=

# ─── South African Retailer APIs ─────────────────────────────────────────────
# Return not-configured until official retailer API / data feed key exists.
# Do not scrape without explicit permission.
TAKEALOT_API_KEY=
INCREDIBLE_CONNECTION_API_KEY=
EVETECH_API_KEY=
WOOTWARE_API_KEY=
ISTORE_API_KEY=
MAKRO_API_KEY=
COMPUTER_MANIA_API_KEY=
GEEWIZ_API_KEY=

# ─── NVD (National Vulnerability Database) ──────────────────────────────────
# https://nvd.nist.gov/developers/request-an-api-key
# Free tier available (rate-limited). API key gives higher limits.
# Used for optional security/vulnerability advisory only.
NVD_API_KEY=

# ─── Database and Cache ──────────────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=
